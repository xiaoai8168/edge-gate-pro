# 私有检测前置 Worker 的公开主机名（不要带 https:// 或 /check）
DOMAIN=egp-check.aiy.kdns.fr

# 与 Cloudflare Worker Secret EDGE_HMAC_SECRET 完全一致，至少 24 字符
CHECK_HMAC_SECRET=

# 检测参数
CHECK_CONCURRENCY=8
CHECK_TIMEOUT=25
CHECK_DEADLINE=1200
MAX_CHECK_NODES=0
REQUIRE_EXIT_IP=true

# 发布质量与多样性
MIN_SUCCESS_RATIO=0.30
MIN_PREVIOUS_RATIO=0.35
ALLOW_LARGE_DROP=false
MAX_PER_EXIT_IP=1
MAX_RESIDENTIAL_PER_COUNTRY=20
MAX_DATACENTER_PER_COUNTRY=10
MAX_PER_ASN_PER_COUNTRY=6
MAX_UNKNOWN_ASN_PER_COUNTRY=2
MAX_TOTAL_NODES=0

# 可选：覆盖数据源与产物地址
VPNGATE_API=
VPNGATE_MIRROR=
NODES_URL=
PREVIOUS_DATA_URL=

# Optional compatibility fallback only when the runtime reports unsupported Web Crypto MD5.
PATCH_RELAY_MD5=false
